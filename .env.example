# Contact delivery — at least one of Resend or Slack must be set in production.
# Names only. Never commit real values.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# From address. Use a verified Resend domain in production.
# Example: Futurebits <hello@futurebits.tech>
CONTACT_FROM_EMAIL=

# Inbox that receives inquiries (defaults to admin@futurebits.tech)
CONTACT_TO_EMAIL=

# Optional Slack incoming webhook for operator alerts
SLACK_CONTACT_WEBHOOK_URL=
